class SupportCopilot:
    def __init__(
        self,
        remote_models: bool = False,
        llama_base: str = LLAMA_BASE,
        llama_models: Optional[list[str]] = None,
        api_key: Optional[str] = None,
    ):
        self.index = KnowledgeIndex(seed_kb())
        self.store = ConversationStore()
        self.remote_models = remote_models
        self.llama_base = llama_base
        self.llama_models = llama_models or list(LLAMA_MODELS)
        self.api_key = api_key
        self.runs: dict[str, dict] = {}

    def stats(self) -> dict:
        return {
            "documents": len({c.doc_id for c in self.index.chunks}),
            "chunks": len(self.index.chunks),
            "app": APP_NAME,
        }

    def chat(
        self,
        message: str,
        conversation_id: Optional[str] = None,
        remote_models: Optional[bool] = None,
        user_id: str = "customer",
    ) -> dict:
        t0 = time.time()
        conversation_id = conversation_id or f"conv_{uuid.uuid4().hex[:10]}"
        msg = message.strip()
        use_remote = self.remote_models if remote_models is None else remote_models
        model_route: list[str] = []
        failures: list[dict] = []

        self.store.add(conversation_id, "user", msg)
        history_blob = self.store.context_blob(conversation_id)

        # Retrieval — include recent user turns for context-aware search
        prior_user = " ".join(
            t.content for t in self.store.history(conversation_id) if t.role == "user"
        )[-400:]
        query = f"{prior_user} {msg}".strip()
        hits = self.index.search(query, k=4)

        # Human request short-circuit
        if wants_human(msg):
            ticket = self._escalate(
                conversation_id,
                user_id,
                msg,
                hits,
                "Customer requested a human agent.",
            )
            answer = (
                "I am connecting you with a support specialist. "
                f"Ticket {ticket['id']} is open and includes this conversation."
            )
            result = self._pack(
                conversation_id,
                user_id,
                msg,
                answer,
                0.99,
                [],
                True,
                ticket,
                model_route or ["policy"],
                failures,
                t0,
                hits,
            )
            self.store.add(conversation_id, "assistant", answer, {"escalated": True})
            return result

        draft = grounded_answer(msg, hits, history_blob)

        # Optional Llama polish grounded on citations
        if use_remote and not draft["should_escalate"]:
            polished, route, fail = self._maybe_llama(msg, draft, hits, history_blob)
            model_route.extend(route)
            failures.extend(fail)
            if polished:
                draft = {**draft, "answer": polished}
        else:
            model_route.append("grounded-retrieval")

        ticket = None
        if draft["should_escalate"]:
            ticket = self._escalate(
                conversation_id,
                user_id,
                msg,
                hits,
                draft.get("escalation_reason") or "Insufficient knowledge coverage.",
            )
            draft["answer"] = (
                f"{draft['answer']} Ticket {ticket['id']} has been created for follow-up."
            )

        answer = strip_machine_labels(draft["answer"])
        result = self._pack(
            conversation_id,
            user_id,
            msg,
            answer,
            draft["confidence"],
            draft["citations"],
            draft["should_escalate"],
            ticket,
            model_route,
            failures,
            t0,
            hits,
        )
        self.store.add(
            conversation_id,
            "assistant",
            answer,
            {"citations": draft["citations"], "escalated": draft["should_escalate"]},
        )
        self.runs[result["id"]] = result
        return result

    def _maybe_llama(
        self,
        question: str,
        draft: dict,
        hits: list[dict],
        history_blob: str,
    ) -> tuple[Optional[str], list[str], list[dict]]:
        routes: list[str] = []
        fails: list[dict] = []
        context = "\n\n".join(f"[{i+1}] {h['title']}: {h['text']}" for i, h in enumerate(hits[:3]))
        messages = [
            {
                "role": "system",
                "content": (
                    "You are a customer support assistant for Northline. "
                    "Answer only from the provided articles. Keep citation markers like [1]. "
                    "Do not invent policy. Do not add origin labels."
                ),
            },
            {
                "role": "user",
                "content": (
                    f"History:\n{history_blob[-600:]}\n\n"
                    f"Articles:\n{context}\n\n"
                    f"Question: {question}\n\n"
                    f"Draft: {draft['answer']}\n\n"
                    "Rewrite the draft in 2–4 clear sentences. Keep facts and [n] markers."
                ),
            },
        ]
        grounded = context + draft["answer"]
        for model in self.llama_models:
            try:
                resp = llama_complete(
                    self.llama_base,
                    model,
                    messages,
                    max_tokens=220,
                    timeout=1.8,
                    api_key=self.api_key,
                )
                text = strip_machine_labels(resp["content"].strip())
                if accept_polish(grounded, text):
                    routes.append(model)
                    return text, routes, fails
                fails.append(
                    {"step": "llama_polish", "message": f"{model} failed grounding guard", "recovered": True}
                )
                routes.append(f"{model}:rejected")
            except Exception as err:  # noqa: BLE001
                fails.append({"step": "llama_polish", "message": str(err), "recovered": True})
                routes.append(f"{model}:failed")
        routes.append("grounded-retrieval")
        return None, routes, fails

    def _escalate(
        self,
        conversation_id: str,
        user_id: str,
        message: str,
        hits: list[dict],
        reason: str,
    ) -> dict:
        ticket = {
            "id": f"tkt_{uuid.uuid4().hex[:8]}",
            "conversation_id": conversation_id,
            "user_id": user_id,
            "status": "open",
            "reason": strip_machine_labels(reason),
            "latest_message": message,
            "history": [
                {"role": t.role, "content": t.content}
                for t in self.store.history(conversation_id)
            ],
            "cited_articles": [
                {"doc_id": h["doc_id"], "title": h["title"], "source": h["source"]}
                for h in hits[:3]
            ],
            "created_ms": int(time.time() * 1000),
        }
        self.store.save_ticket(ticket)
        return ticket

    def _pack(
        self,
        conversation_id: str,
        user_id: str,
        message: str,
        answer: str,
        confidence: float,
        citations: list[dict],
        escalated: bool,
        ticket: Optional[dict],
        model_route: list[str],
        failures: list[dict],
        t0: float,
        hits: list[dict],
    ) -> dict:
        return {
            "id": f"msg_{uuid.uuid4().hex[:8]}",
            "conversation_id": conversation_id,
            "user_id": user_id,
            "message": message,
            "answer": answer,
            "confidence": confidence,
            "citations": citations,
            "escalated": escalated,
            "ticket": ticket,
            "structured": {
                "intent": self._intent(message, hits),
                "category": hits[0]["category"] if hits else "unknown",
                "action": "escalate" if escalated else "resolve",
                "citation_ids": [c["id"] for c in citations],
            },
            "model_route": model_route,
            "failures": failures,
            "retrieval": [
                {"doc_id": h["doc_id"], "title": h["title"], "score": h["score"]}
                for h in hits
            ],
            "timings": {
                "total_ms": round((time.time() - t0) * 1000, 2),
                "sla_ms": SLA_MS,
                "within_sla": (time.time() - t0) * 1000 <= SLA_MS,
            },
        }

    def _intent(self, message: str, hits: list[dict]) -> str:
        if wants_human(message):
            return "request_human"
        if not hits:
            return "unknown"
        return hits[0]["category"]


