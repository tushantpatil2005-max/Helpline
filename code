# Response builder
# ---------------------------------------------------------------------------


def grounded_answer(question: str, hits: list[dict], history_blob: str) -> dict:
    """Build a source-backed answer without a remote model."""
    if not hits:
        return {
            "answer": (
                "I do not have enough information in the knowledge base to answer that. "
                "I can escalate this to a support specialist."
            ),
            "confidence": 0.15,
            "citations": [],
            "should_escalate": True,
            "escalation_reason": "No relevant knowledge base articles found.",
        }

    top_cov = coverage(question, " ".join(h["text"] for h in hits[:3]))
    citations = []
    for i, h in enumerate(hits[:3], 1):
        citations.append(
            {
                "id": i,
                "doc_id": h["doc_id"],
                "title": h["title"],
                "source": h["source"],
                "category": h["category"],
                "excerpt": re.sub(r"\s+", " ", h["text"])[:220],
                "score": h["score"],
            }
        )

    # Compose from top excerpts
    sentences = []
    for h in hits[:2]:
        for sent in re.split(r"(?<=[.!?])\s+", h["text"]):
            sent = sent.strip()
            if len(sent) < 40:
                continue
            if coverage(question, sent) >= 0.12 or coverage(question, h["title"]) >= 0.3:
                sentences.append(sent)
    if not sentences:
        sentences = [hits[0]["text"][:280]]

    body = " ".join(sentences[:3])
    # Attach citation markers
    if citations:
        body = f"{body} [{citations[0]['id']}]"
        if len(citations) > 1 and len(sentences) > 1:
            body = body.rstrip()
            # second cite on last sentence boundary if possible
            body = f"{body} See also [{citations[1]['id']}]."

    conf = round(min(0.95, 0.35 + top_cov * 0.4 + hits[0]["score"] * 0.3), 2)
    escalate = top_cov < COVERAGE_ABSTAIN or conf < 0.4
    reason = ""
    if escalate:
        reason = "Retrieved articles do not cover enough of the question."
        body = (
            "I could not find a complete answer in the knowledge base for this question. "
            "A support specialist can take it from here."
        )
        conf = min(conf, 0.35)

    return {
        "answer": strip_machine_labels(body),
        "confidence": conf,
        "citations": citations if not escalate else citations[:1],
        "should_escalate": escalate,
        "escalation_reason": reason,
    }


