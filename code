def llama_complete(
    base_url: str,
    model: str,
    messages: list[dict],
    max_tokens: int = 280,
    timeout: float = 2.0,
    api_key: Optional[str] = None,
) -> dict:
    url = base_url.rstrip("/") + "/v1/chat/completions"
    body = json.dumps(
        {
            "model": model,
            "temperature": 0.2,
            "max_tokens": max_tokens,
            "messages": messages,
        }
    ).encode()
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    req = Request(url, data=body, headers=headers, method="POST")
    with urlopen(req, timeout=timeout) as resp:
        data = json.loads(resp.read().decode())
    choice = (data.get("choices") or [{}])[0]
    msg = choice.get("message") or {}
    usage = data.get("usage") or {}
    return {
        "content": msg.get("content") or "",
        "tokens_in": usage.get("prompt_tokens", estimate_tokens("\n".join(m["content"] for m in messages))),
        "tokens_out": usage.get("completion_tokens", estimate_tokens(msg.get("content") or "")),
        "model": model,
    }


def accept_polish(grounded: str, polished: str) -> bool:
    polished = strip_machine_labels(polished)
    if len(polished) < 20:
        return False
    # Numbers in polish must appear in grounded context
    allowed = set(re.findall(r"\d+", grounded))
    for n in re.findall(r"\d+", polished):
        if n not in allowed:
            return False
    return True


# ---------------------------------------------------------------------------
# Escalation heuristics
# ---------------------------------------------------------------------------

ESCALATION_PHRASES = [
    r"\btalk to (a )?human\b",
    r"\bspeak to (an? )?agent\b",
    r"\breal person\b",
    r"\bescalat",
    r"\bmanager\b",
    r"\bcomplaint\b",
    r"\blawyer\b",
    r"\blegal\b",
    r"\bfraud\b",
    r"\bhack(ed)?\b",
]


def wants_human(message: str) -> bool:
    return any(re.search(p, message, re.I) for p in ESCALATION_PHRASES)


