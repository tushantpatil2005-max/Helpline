def self_check() -> list[str]:
    notes: list[str] = []
    bot = SupportCopilot(remote_models=False)
    assert bot.stats()["documents"] >= 6

    # Billing question with citations
    r1 = bot.chat("How do I download my invoice PDF?", conversation_id="c1")
    assert r1["answer"]
    assert r1["citations"], "expected citations"
    assert not r1["escalated"]
    assert r1["structured"]["action"] == "resolve"
    assert "invoice" in r1["answer"].lower() or "billing" in r1["answer"].lower()
    notes.append(f"invoice conf={r1['confidence']} cites={len(r1['citations'])}")

    # Chat memory: follow-up in same conversation
    r2 = bot.chat("What about refunds on monthly plans?", conversation_id="c1")
    assert r2["conversation_id"] == "c1"
    assert r2["citations"] or r2["escalated"]
    hist = bot.store.history("c1")
    assert len(hist) >= 4  # 2 user + 2 assistant
    notes.append(f"memory turns={len(hist)} refund_escalated={r2['escalated']}")

    # Escalation on explicit human request
    r3 = bot.chat("I want to talk to a human agent please", conversation_id="c2")
    assert r3["escalated"] is True
    assert r3["ticket"] and r3["ticket"]["id"].startswith("tkt_")
    assert r3["structured"]["action"] == "escalate"
    notes.append(f"ticket={r3['ticket']['id']}")

    # Out-of-knowledge escalation
    r4 = bot.chat("What is the warranty on the 1998 World Cup official ball?", conversation_id="c3")
    assert r4["escalated"] is True
    notes.append(f"ood conf={r4['confidence']}")

    # Structured JSON keys
    for key in ("answer", "citations", "structured", "conversation_id", "confidence"):
        assert key in r1

    blob = json.dumps(r1) + json.dumps(r3)
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)
    assert r1["timings"]["within_sla"]

    return notes


# ---------------------------------------------------------------------------
# FastAPI
# ---------------------------------------------------------------------------

if HAS_FASTAPI:
    app = FastAPI(title="Helpline Support Copilot", version="1.0.0")
    _bot = SupportCopilot(remote_models=False)

    class ChatBody(BaseModel):
        message: str = Field(..., min_length=1)
        conversation_id: Optional[str] = None
        user_id: str = "customer"
        remote_models: bool = False

    @app.get("/health")
    def health():
        return {"ok": True, "app": APP_NAME, "stats": _bot.stats()}

    @app.post("/chat")
    def chat(body: ChatBody):
        return _bot.chat(
            body.message,
            conversation_id=body.conversation_id,
            user_id=body.user_id,
            remote_models=body.remote_models,
        )

    @app.get("/tickets/{ticket_id}")
    def ticket(ticket_id: str):
        t = _bot.store.get_ticket(ticket_id)
        if not t:
            raise HTTPException(status_code=404, detail="Ticket not found")
        return t


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="AI Customer Support Copilot")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("-m", "--message", type=str)
    parser.add_argument("--conversation", default=None)
    parser.add_argument("--remote", action="store_true")
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = self_check()
        print("PASS")
        for n in notes:
            print(n)
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    if not args.message:
        parser.print_help()
        return

    bot = SupportCopilot(remote_models=args.remote)
    result = bot.chat(args.message, conversation_id=args.conversation, remote_models=args.remote)
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
