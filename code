@dataclass
class Chunk:
    id: str
    doc_id: str
    title: str
    category: str
    source: str
    text: str
    toks: list[str]
    tf: Counter
    vec: list[float]


class KnowledgeIndex:
    def __init__(self, docs: list[dict]):
        self.chunks: list[Chunk] = []
        self.df: Counter = Counter()
        for doc in docs:
            for i, text in enumerate(chunk_text(doc["text"])):
                toks = tokens(text)
                self.chunks.append(
                    Chunk(
                        id=f"{doc['id']}:{i}",
                        doc_id=doc["id"],
                        title=doc["title"],
                        category=doc["category"],
                        source=doc["source"],
                        text=text,
                        toks=toks,
                        tf=Counter(toks),
                        vec=embed(text),
                    )
                )
        for c in self.chunks:
            for term in set(c.toks):
                self.df[term] += 1
        total = sum(len(c.toks) for c in self.chunks) or 1
        self.avg_len = total / max(1, len(self.chunks))

    def _bm25(self, chunk: Chunk, q_tokens: list[str]) -> float:
        N = len(self.chunks)
        dl = len(chunk.toks) or 1
        score = 0.0
        seen = set()
        for term in q_tokens:
            if term in seen:
                continue
            seen.add(term)
            tf = chunk.tf.get(term, 0)
            if not tf:
                continue
            df = self.df.get(term, 0)
            idf = math.log(1 + (N - df + 0.5) / (df + 0.5))
            denom = tf + BM25_K1 * (1 - BM25_B + BM25_B * (dl / self.avg_len))
            score += idf * ((tf * (BM25_K1 + 1)) / denom)
        return score

    def search(self, query: str, k: int = 4) -> list[dict]:
        q_tokens = tokens(query)
        if not q_tokens or not self.chunks:
            return []
        q_vec = embed(query)
        bm = [self._bm25(c, q_tokens) for c in self.chunks]
        dense = [max(0.0, cosine(q_vec, c.vec)) for c in self.chunks]

        def ranks(values: list[float]) -> list[int]:
            order = sorted(range(len(values)), key=lambda i: values[i], reverse=True)
            r = [0] * len(values)
            for rank, i in enumerate(order, 1):
                r[i] = rank
            return r

        bm_r, den_r = ranks(bm), ranks(dense)
        hits = []
        for i, c in enumerate(self.chunks):
            rrf = 1 / (RRF_K + bm_r[i]) + 1 / (RRF_K + den_r[i])
            cov = coverage(query, c.text)
            score = 0.5 * rrf + 0.3 * dense[i] + 0.2 * cov
            hits.append(
                {
                    "id": c.id,
                    "doc_id": c.doc_id,
                    "title": c.title,
                    "category": c.category,
                    "source": c.source,
                    "text": c.text,
                    "score": round(score, 4),
                }
            )
        hits.sort(key=lambda h: h["score"], reverse=True)
        return hits[:k]


# ---------------------------------------------------------------------------
# Chat memory
# ---------------------------------------------------------------------------


@dataclass
class Turn:
    role: str  # user | assistant | system
    content: str
    meta: dict = field(default_factory=dict)


class ConversationStore:
    def __init__(self):
        self._chats: dict[str, list[Turn]] = defaultdict(list)
        self._tickets: dict[str, dict] = {}

    def history(self, conversation_id: str, limit: int = 12) -> list[Turn]:
        return list(self._chats.get(conversation_id, [])[-limit:])

    def add(self, conversation_id: str, role: str, content: str, meta: Optional[dict] = None):
        self._chats[conversation_id].append(Turn(role, content, meta or {}))
        self._chats[conversation_id] = self._chats[conversation_id][-40:]

    def context_blob(self, conversation_id: str) -> str:
        parts = []
        for t in self.history(conversation_id):
            parts.append(f"{t.role}: {t.content}")
        return "\n".join(parts)

    def save_ticket(self, ticket: dict):
        self._tickets[ticket["id"]] = ticket

    def get_ticket(self, ticket_id: str) -> Optional[dict]:
        return self._tickets.get(ticket_id)


